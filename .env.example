# =====================================================================
# GeoBY ayarları — bu dosyayı ".env.local" adıyla kopyalayın:
#   cp .env.example .env.local
# Hiçbir şey doldurmasanız da uygulama çalışır: veriler bilgisayarınızda
# saklanır, cevaplar elle yapıştırılarak ölçülür.
# Değişiklikten sonra uygulamayı yeniden başlatın (npm run dev).
# =====================================================================

# ---------------------------------------------------------------------
# 1) ÜCRETSİZ ANAHTARLAR (önerilen; ikisi de birkaç dakikada alınır)
# ---------------------------------------------------------------------
# Groq — https://console.groq.com/keys
#   ChatGPT'yi OpenAI'nin açık modeli gpt-oss ile yaklaşık ölçer;
#   kurulumdaki site analizini ve önerileri de yapar.
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
#   Gemini'yi ölçer. Ücretsiz katmanın günlük sınırı vardır.
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# 2) KENDİ BİLGİSAYARINIZDAKİ MODEL (isteğe bağlı, ücretsiz, sınırsız)
# ---------------------------------------------------------------------
# Ollama, LM Studio veya llama.cpp'nin OpenAI uyumlu adresi:
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   llama.cpp:  http://localhost:8080/v1   (llama-server -m model.gguf --port 8080)
# Site analizi ve önerilerde kullanılır; "Yerel model" olarak da ölçülebilir.
LOCAL_AI_URL=
# Sunucu birden çok model sunuyorsa hangisi (ör. qwen2.5-coder:7b):
LOCAL_AI_MODEL=

# ---------------------------------------------------------------------
# 3) ANAHTARSIZ DENEME MODU
# ---------------------------------------------------------------------
# Hiç anahtar yoksa ChatGPT sorusu Pollinations üzerinden küçük bir açık
# modelle sorulur (45 saniyede bir cevap, sonuçlar kabadır). Kapatmak için false.
POLLINATIONS_ENABLED=true

# ---------------------------------------------------------------------
# 4) ÜCRETLİ (isteğe bağlı; yoksa bu asistanlar elle ölçülür)
# ---------------------------------------------------------------------
# Gerçek ChatGPT modeli
OPENAI_API_KEY=
# Claude
ANTHROPIC_API_KEY=
# Perplexity (kaynak listesiyle)
PERPLEXITY_API_KEY=

# Model adını sabitlemek isterseniz (normalde gerekmez; uygulama sağlayıcının
# güncel model listesinden seçer):
# GEMINI_MODEL=
# GROQ_MODEL=
# OPENAI_MODEL=
# ANTHROPIC_MODEL=claude-opus-5-5
# PERPLEXITY_MODEL=sonar

# ---------------------------------------------------------------------
# 5) VERİTABANI (isteğe bağlı)
# ---------------------------------------------------------------------
# Boş bırakırsanız veriler .data/geoby.json dosyasında tutulur.
# Sunucuya kurmak / ekiple paylaşmak için Supabase bilgilerini girin:
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------
# 6) ERİŞİM PAROLASI (uygulamayı internete açacaksanız mutlaka girin)
# ---------------------------------------------------------------------
GEOBY_PASSWORD=

# ---------------------------------------------------------------------
# 7) DÜZENLİ TEST
# ---------------------------------------------------------------------
# Ayarlar > Düzenli test açıksa, uygulama çalıştığı sürece zamanı gelen
# testler kendiliğinden yapılır. Kapatmak için false:
GEOBY_AUTORUN=
# Sunucusuz kurulumda (Vercel vb.) zamanlanmış görev /api/cron adresini
# "Authorization: Bearer <CRON_SECRET>" ile çağırır:
CRON_SECRET=
