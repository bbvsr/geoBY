# =====================================================================
# GeoBY ayarları — bu dosyayı ".env.local" adıyla kopyalayın:
#   cp .env.example .env.local
# Hiçbir şey doldurmasanız da uygulama çalışır (yerel mod + manuel test).
# =====================================================================

# ---------------------------------------------------------------------
# 1) YAPAY ZEKA — ÜCRETSİZ ANAHTARLAR (önerilen, ikisi de 2 dakikada alınır)
# ---------------------------------------------------------------------
# Google Gemini — https://aistudio.google.com/apikey
#   Gemini ölçümü + Google arama kaynakları + kurulumda site analizi
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys
#   ChatGPT ölçümü (OpenAI'nin açık modeli gpt-oss-120b ile), çok hızlı
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys  (Groq'a alternatif, ":free" modeller)
OPENROUTER_API_KEY=

# Pollinations — anahtar gerektirmez; hiç anahtar yoksa son çare olarak kullanılır.
# Kapatmak için false yapın.
POLLINATIONS_ENABLED=true

# ---------------------------------------------------------------------
# 2) YAPAY ZEKA — ÜCRETLİ (isteğe bağlı; yoksa bu modeller manuel test edilir)
# ---------------------------------------------------------------------
# Gerçek ChatGPT (gpt-4o-mini)
OPENAI_API_KEY=
# Claude
ANTHROPIC_API_KEY=
# Perplexity (sonar) + kaynak listesi
PERPLEXITY_API_KEY=

# Model adlarını değiştirmek isterseniz (varsayılanlar yeterlidir):
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_ASSISTANT_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-opus-5-5
# PERPLEXITY_MODEL=sonar

# ---------------------------------------------------------------------
# 3) VERİTABANI (isteğe bağlı)
# ---------------------------------------------------------------------
# Boş bırakırsanız veriler bilgisayarınızda .data/geoby.json dosyasında tutulur.
# Sunucuya kurmak / ekiple paylaşmak için Supabase bilgilerini girin:
SUPABASE_URL=
SUPABASE_SECRET_KEY=
